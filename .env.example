# Supabase PostgreSQL connection string
DATABASE_URL=postgresql://postgres:password@db.xxxxx.supabase.co:5432/postgres

# Verified email of the Site owner
JSTORE_OWNER_EMAIL=

# Default passwords (change in production!)
JSTORE_OWNER_PASSWORD=owner123
JSTORE_ADMIN_PASSWORD=admin123

# Session signing secret (change in production!)
JSTORE_AUTH_SECRET=jstore-auth-secret-key-2026
